---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = '/blog-placeholder-1.jpg' } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Đặt giao diện sáng tối TRƯỚC khi trang vẽ ra để không nháy màu -->
<script is:inline>
	(function () {
		var root = document.documentElement;
		var saved = null;
		try {
			saved = localStorage.getItem('thupho-theme');
		} catch (e) {}
		if (saved !== 'light' && saved !== 'dark') saved = null;
		var h = new Date().getHours(); // giờ theo múi giờ trên máy người xem
		var auto = h >= 6 && h < 18 ? 'light' : 'dark';
		root.setAttribute('data-theme', saved || auto);
		root.setAttribute('data-theme-mode', saved ? 'manual' : 'auto');
		root.classList.add('js');
	})();
</script>

<!-- Dùng thống nhất Be Vietnam Pro, có đầy đủ dấu tiếng Việt -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&display=swap&subset=vietnamese"
	rel="stylesheet"
/>

<link rel="alternate" type="application/rss+xml" title={title} href="/rss.xml" />
<link rel="canonical" href={canonicalURL} />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />
